# ── Leadget ──────────────────────────────────────────────────────────
# Copy to .env.local. Every key is optional for your own copy.
# With none set, Leadget stores everything in .data/leadget.json on this
# machine, finds businesses through OpenStreetMap, and writes pitches from
# the built-in industry playbooks.

# personal (default, leave empty) = just you.  saas = anyone can sign up.
APP_MODE=

# ── Shared ───────────────────────────────────────────────────────────
# AI-written pitches and follow-ups (free key: https://console.groq.com/keys).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Better business search: websites, phone numbers and ratings from Google Maps.
# Enable "Places API (New)" in Google Cloud and paste the key here.
GOOGLE_PLACES_API_KEY=

# Real mobile speed scores + a phone screenshot in your website reports.
# Works without a key at low volume; a free key lifts the limit
# (Google Cloud → enable "PageSpeed Insights API").
PAGESPEED_API_KEY=

# Your own Nominatim server (required for OpenStreetMap search in SaaS mode;
# the public one is only for personal use).
# NOMINATIM_URL=

# ── Personal mode ────────────────────────────────────────────────────
# Lock the app behind a passcode. Set this before you deploy anywhere public.
APP_PASSCODE=

# Cloud storage instead of the local file (required on Vercel).
# Run supabase/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SaaS mode (APP_MODE=saas) ────────────────────────────────────────
# A SEPARATE Supabase project from your personal one. Run supabase/schema.sql.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above are required too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_GOOGLE_AUTH=

# Paystack: secret key + one plan code per paid plan (Paystack → Plans).
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
